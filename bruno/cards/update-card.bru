meta {
  name: Update card (partial)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/cards/3
  body: json
  auth: none
}

body:json {
  {
    "version": 1,
    "variant": "Shadowless"
  }
}

docs {
  Optimistic locking: the version must match the last GET.
  Run once and the version becomes 2 - running again with version 1
  returns 409 (re-GET to see the current version).
}
