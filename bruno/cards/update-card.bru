meta {
  name: Update card (partial)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/cards/3
  body: json
  auth: none
}

headers {
  If-Match: {{cardEtag}}
}

body:json {
  {
    "variant": "Shadowless"
  }
}

docs {
  Run "Get card" first: it captures {{cardEtag}} and the update must
  send it in If-Match. A missing header returns 428, a stale ETag 412.
}
