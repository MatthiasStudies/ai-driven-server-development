meta {
  name: Delete binder
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/binders/4?version=1
  body: none
  auth: none
}

docs {
  Deleting a binder cascades to its cards and certificates.
  Seed data has binders 1-3; run "Create binder" first to have a binder 4.
  The version must match the last GET, otherwise 409.
}
