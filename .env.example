# Postgres connection used by the application and the docker-compose service.
# Variable names mirror the official Postgres image, so one file configures both.
POSTGRES_USER=tcg_user
POSTGRES_PASSWORD=tcg_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tcg_tracker

# Optional full override of the application database URL (e.g. for CI).
# DATABASE_URL=postgresql+psycopg://tcg_user:tcg_password@localhost:5432/tcg_tracker

# Optional full override of the database URL used by the test suite.
# TEST_DATABASE_URL=postgresql+psycopg://tcg_user:tcg_password@localhost:5432/tcg_tracker_test
